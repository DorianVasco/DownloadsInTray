<Window x:Class="WinDownload.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDownload Settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <StackPanel Margin="24,20">
        <CheckBox x:Name="StartAtLogin"
                  Content="Start at login"
                  Click="OnStartAtLoginClick" />
        <TextBlock Margin="28,2,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Makes the first click after a restart instant."
                   TextWrapping="Wrap" />

        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Notification time"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="NotificationTimeValue"
                       Grid.Column="1"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Slider x:Name="NotificationTime"
                Margin="0,8,0,0"
                AutomationProperties.Name="Notification time in seconds"
                IsSnapToTickEnabled="True"
                LargeChange="5"
                SmallChange="1"
                TickFrequency="1"
                ValueChanged="OnNotificationTimeChanged" />
    </StackPanel>
</Window>
