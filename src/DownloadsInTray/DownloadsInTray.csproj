<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>DownloadsInTray.Program</StartupObject>
    <ApplicationIcon>Assets\DownloadsInTray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Product is the display name; AssemblyName names the exe, settings folder and setup files. -->
    <Product>Downloads in Tray</Product>
    <AssemblyName>DownloadsInTray</AssemblyName>
    <RootNamespace>DownloadsInTray</RootNamespace>
    <Version>1.0.2</Version>
    <!-- Application.ThemeMode (Fluent theme) is still flagged experimental. -->
    <!-- WFO0003: DPI awareness stays in app.manifest because WPF, not WinForms, owns the UI. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The self-contained build bundles the runtime and WPF's native libraries into the one exe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SelfContained)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DownloadsInTray.ico" LogicalName="DownloadsInTray.ico" />
    <EmbeddedResource Include="Assets\icon.svg" LogicalName="icon.svg" />
    <EmbeddedResource Include="Assets\icon2-mono-dark.svg" LogicalName="icon2-mono-dark.svg" />
    <EmbeddedResource Include="Assets\icon2-mono-light.svg" LogicalName="icon2-mono-light.svg" />
  </ItemGroup>

</Project>
